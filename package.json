{
	"name": "nodewatcher",
	"productName": "NodeWatcher",
	"version": "1.0.0",
	"description": "App for monitoring homelab nodes",
	"homepage": "https://github.com/B4rawasz/NodeWatcher#readme",
	"bugs": {
		"url": "https://github.com/B4rawasz/NodeWatcher/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/B4rawasz/NodeWatcher.git"
	},
	"license": "MIT",
	"author": "B4rawasz",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently 'npm run dev --workspace @nodewatcher/vite' 'nodemon -e ts,cts,json --watch packages/electron/src --watch packages/shared/src --exec \"npm run dev --workspace @nodewatcher/electron\"'",
		"build": "npm run build --workspaces"
	},
	"devDependencies": {
		"concurrently": "9.2.1",
		"nodemon": "3.1.14"
	}
}
